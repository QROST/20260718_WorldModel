# Provenance: https://github.com/QROST/20260718_WorldModel

# Copy this file to .env.local, fill the values, then run chmod 600 .env.local.
# Reactor keys: https://www.reactor.inc/account/api-keys
# OpenAI keys: https://platform.openai.com/settings/organization/api-keys
REACTOR_API_KEY=
OPENAI_API_KEY=

# Optional — Reactor API base URL. Defaults to https://api.reactor.inc
# REACTOR_API_BASE_URL=https://api.reactor.inc

# Public deployments must declare their one canonical browser origin.
# Localhost, 127.0.0.1 and [::1] remain the only implicit origins.
# FASHION_MAZE_PUBLIC_ORIGIN=https://maze.example.com

# Keep disabled unless a trusted reverse proxy strips and overwrites every
# client-supplied Forwarded/X-Forwarded-* header before the request reaches Next.
# FASHION_MAZE_TRUST_PROXY_HEADERS=0
